{{define "doc_summary"}}
    {{- if .Description}}
        {{- .Description}}
    {{- end}}

    {{if .Enumerations}}
        {{- indent 0 ""}}**Allowed Values:**

        {{- range .Enumerations}}
            {{- indent 0 ""}}- `{{.}}`
        {{- end}}
    {{- end}}

    {{if .RegexPattern}}
        {{- indent 0 ""}}**Regex Pattern:**

        {{- indent 0 ""}}```
        {{- indent 0 ""}}{{.RegexPattern}}
        {{- indent 0 ""}}```


        {{if (gt (.RegexExamples | len) 0)}}
            {{- indent 0 ""}}Example Matches:

            {{- range .RegexExamples}}
                {{- indent 0 ""}}- `{{.}}`
            {{- end}}
        {{- end}}
    {{- end}}

    {{if .Examples}}
        {{- indent 0 ""}}**Examples:**

        {{- range .Examples}}
            {{- indent 0 ""}}- [{{.Name}}]({{.Content}})
        {{- end}}
    {{- end}}

    {{if .Links}}
        {{- indent 0 ""}}**Links:**

        {{- range .Links}}
            {{- indent 0 ""}}- [{{.Name}}]({{.Content}})
        {{- end}}
    {{- end}}

    {{if .Attributes}}
        {{- range .Attributes}}
            {{- indent 0 ""}}**{{.Name}}:** {{.Content}}
        {{end}}
    {{- end}}
{{end}}

{{define "table" -}}
    {{ template "doc_summary" . -}}

    <table><thead><tr><th>Type</th><th align="left" width="100%">Name</th>{{if eq .Type 0}}<th>Required</th>{{end}}<th>{{if eq .Type 3}}Sensitive{{else}}Default&nbsp;Value{{end}}</th></tr></thead><tbody>
        {{range .Rows -}}
            {{template "table_row" . -}}
        {{ end -}}
    </tbody></table>
{{- end}}

{{define "table_row" -}}
<tr>
    <td>
        {{- if .ComplexType -}}
            <code>
                {{- index .GetParentType 0 -}}
                <a href="#{{.GetAnchor}}">{{.ComplexType}}</a>
                {{- index .GetParentType 1 -}}
            </code>
        {{- else -}}
            <code>{{.Type}}</code>
        {{- end -}}
    </td>
    <td width="100%">{{.Name}}</td>
    {{- if eq .ParentType 0 }}<td>{{if .Required}}Yes{{end}}</td>{{end -}}
    <td>{{if .Required}}<em>n/a</em>{{else if .HasDefaultValue}}<code>{{.DefaultValue}}</code>{{else if .Sensitive}}Yes{{end}}</td>
</tr>
<tr><td colspan="{{ if eq .ParentType 0 }}4{{else}}3{{end}}">

{{template "doc_summary" .}}

</td></tr>
{{end}}

## Inputs

### Required

{{if eq (len .RequiredInputs.Rows) 0 -}}
    _No required inputs._
{{else}}
    {{- template "table" .RequiredInputs}}
{{end}}

{{if gt (len .OptionalInputs.Rows) 0 -}}
### Optional

{{template "table" .OptionalInputs}}
{{end}}

{{if gt (len .Outputs.Rows) 0 -}}
## Outputs

{{template "table" .Outputs}}
{{end}}

{{if gt (len .Objects) 0}}
## Objects

{{range $key, $input := .Objects}}

#### {{$key}}

{{template "table" $input}}

{{end}}
{{end}}

{{range $key, $value := .ReferenceLinks}}
[{{$key}}]: {{$value}}
{{end}}
